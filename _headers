# ============================================================
# Netlify — en-têtes HTTP
# Les fichiers d'assets portent un nom stable, on peut donc les
# mettre en cache très longtemps. Les pages HTML, elles, doivent
# être revalidées à chaque visite pour que les mises à jour
# soient visibles immédiatement.
# ============================================================

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# style.css et les scripts gardent le même nom : pas d'immutable, sinon
# une modification ne parvient jamais aux visiteurs déjà venus.
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-Frame-Options: SAMEORIGIN
